---
import type { CollectionEntry } from "astro:content";
import TechBadge from "./TechBadge.astro";
import { CATEGORY_LABELS } from "../consts";

interface Props {
	project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, description, category, tech, coverImage } = project.data;
---

<a class="card" href={`/projects/${project.id}/`} data-category={category} data-spotlight>
	{
		coverImage && (
			<img class="cover" src={coverImage} alt="" width={720} height={360} loading="lazy" />
		)
	}
	<div class="body">
		<span class="category">{CATEGORY_LABELS[category]}</span>
		<h3 class="title">{title}</h3>
		<p class="description">{description}</p>
		<div class="tech">
			{tech.slice(0, 4).map((t) => <TechBadge label={t} />)}
		</div>
	</div>
</a>

<script>
	// Spotlight: update --mx/--my as the mouse moves over the cards.
	// Delegated on document so it survives page transitions.
	document.addEventListener('mousemove', (e) => {
		const card = (e.target as HTMLElement)?.closest<HTMLElement>('[data-spotlight]');
		if (!card) return;
		const rect = card.getBoundingClientRect();
		card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
		card.style.setProperty('--my', `${e.clientY - rect.top}px`);
	});
</script>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		background: rgba(var(--surface-rgb), 0.4);
		backdrop-filter: blur(16px) saturate(150%);
		-webkit-backdrop-filter: blur(16px) saturate(150%);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--box-shadow);
		transition: box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
	}
	/* Spotlight subtle aurora tracking glow */
	.card::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		opacity: 0;
		transition: opacity 0.35s ease;
		background: radial-gradient(
			300px circle at var(--mx, 50%) var(--my, 0%),
			rgba(var(--accent-rgb), 0.12),
			transparent 60%
		);
		pointer-events: none;
		z-index: 0;
	}
	.card:hover {
		transform: translateY(-5px);
		border-color: var(--border-hover);
		box-shadow: 
			0 20px 40px rgba(0, 0, 0, 0.3),
			0 0 15px rgba(var(--accent-rgb), 0.12),
			0 0 0 1px rgba(255, 255, 255, 0.1) inset;
	}
	:root[data-theme="light"] .card:hover {
		box-shadow: 
			0 16px 30px rgba(var(--accent-rgb), 0.08),
			0 0 10px rgba(var(--accent-rgb), 0.04),
			0 0 0 1px rgba(15, 23, 42, 0.02) inset;
	}
	.card:hover::before {
		opacity: 1;
	}
	.card > * {
		position: relative;
		z-index: 1;
	}
	.cover {
		width: 100%;
		height: 180px;
		object-fit: cover;
		border-bottom: 1px solid var(--border);
		transition: transform 0.4s ease;
	}
	.card:hover .cover {
		transform: scale(1.02);
	}
	.body {
		padding: 1.2em;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.category {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-dark);
		font-weight: 600;
	}
	:root[data-theme="light"] .category {
		color: var(--accent);
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.2;
		font-family: "Outfit", sans-serif;
		font-weight: 600;
		color: rgb(var(--black));
	}
	.description {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-top: 0.3em;
	}
</style>
