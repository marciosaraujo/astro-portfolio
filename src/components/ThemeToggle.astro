---

<button id="theme-toggle" type="button" aria-label="Toggle light/dark theme" title="Toggle theme">
	<svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	</svg>
</button>

<style>
	#theme-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2em;
		height: 2.2em;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		color: rgb(var(--black));
		border-radius: 8px;
		line-height: 0;
		transition: background-color 0.2s ease;
	}
	#theme-toggle:hover {
		background: rgb(var(--gray-light));
	}
	#theme-toggle:active {
		transform: scale(0.9);
	}
	/* Crossfade + rotate between icons instead of an instant display swap. */
	#theme-toggle svg {
		position: absolute;
		inset: 0;
		margin: auto;
		transition: opacity 0.25s ease, transform 0.25s ease;
	}
	.icon-sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}
	.icon-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	:global([data-theme='dark']) .icon-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	:global([data-theme='dark']) .icon-moon {
		opacity: 0;
		transform: rotate(90deg) scale(0.6);
	}
</style>

<script>
	// Delegated on document so it keeps working across view transitions
	// (the button element is replaced on each navigation).
	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement)?.closest('#theme-toggle');
		if (!btn) return;
		const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
