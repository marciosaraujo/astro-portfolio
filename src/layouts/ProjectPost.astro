---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import TechBadge from '../components/TechBadge.astro';
import { CATEGORY_LABELS } from '../consts';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, category, tech, repoUrl, demoUrl, coverImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={coverImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				line-height: 1.15;
			}
			.title h1 {
				margin: 0 0 0.3em 0;
				font-family: "Outfit", sans-serif;
				font-weight: 700;
			}
			.category {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--accent-dark);
				font-weight: 600;
			}
			:root[data-theme="light"] .category {
				color: var(--accent);
			}
			.links {
				display: flex;
				gap: 1em;
				margin: 1.2em 0;
				flex-wrap: wrap;
			}
			.links a {
				display: inline-block;
				padding: 0.7em 1.6em;
				border-radius: var(--radius);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.9rem;
				transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background-color 0.2s ease;
			}
			.links a:hover {
				transform: translateY(-2px);
			}
			.links a:active {
				transform: scale(0.97);
			}
			.links a.primary {
				background: var(--accent);
				color: var(--on-accent);
				box-shadow: 0 6px 18px rgba(var(--accent-rgb), 0.3);
			}
			.links a.primary:hover {
				background-color: var(--accent-dark);
				box-shadow: 0 10px 24px rgba(var(--accent-rgb), 0.45);
			}
			.links a.secondary {
				border: 1px solid var(--border);
				color: rgb(var(--black));
				background: rgba(var(--surface-rgb), 0.45);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
			}
			.links a.secondary:hover {
				border-color: var(--border-hover);
				background-color: rgba(var(--surface-rgb), 0.75);
			}
			.tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-bottom: 1em;
			}
			.back {
				display: inline-block;
				margin-bottom: 1.2em;
				color: var(--accent-dark);
				text-decoration: none;
				font-family: "JetBrains Mono", monospace;
				font-size: 0.88rem;
				font-weight: 600;
				transition: opacity 0.2s ease;
			}
			:root[data-theme="light"] .back {
				color: var(--accent);
			}
			.back:hover {
				opacity: 0.8;
			}
		</style>
	</head>

	<body>
		<Background />
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{coverImage && <img width={1020} height={510} src={coverImage} alt="" />}
				</div>
				<div class="prose">
					<a class="back" href="/projects">← Projects</a>
					<div class="title">
						<span class="category">{CATEGORY_LABELS[category]}</span>
						<h1>{title}</h1>
						<div class="tech">
							{tech.map((t) => <TechBadge label={t} />)}
						</div>
						<div class="links">
							{demoUrl && <a class="primary" href={demoUrl} target="_blank" rel="noopener">Live demo ↗</a>}
							{repoUrl && <a class="secondary" href={repoUrl} target="_blank" rel="noopener">Code ↗</a>}
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
